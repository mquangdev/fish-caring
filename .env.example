# Database (docker-compose.yml reads these)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=fishcaring
MYSQL_USER=fishcaring
MYSQL_PASSWORD=

# Backend
DB_URL=jdbc:mysql://localhost:3306/fishcaring
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Web Push (VAPID): all three or none. Create a key pair with:
#   java -cp be/target/classes com.fishcaring.service.VapidKeyGenerator
# VAPID_SUBJECT is mailto:you@example.com or an https:// address. Leave empty to turn Web Push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
