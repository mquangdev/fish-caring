# Copy this file to .env.local (git ignores it) and change the values you need.
# Only names starting with VITE_ reach the browser, so never put a secret here.

# Where the browser sends API calls, including "/api".
# Empty means the same domain ("/api"): the dev server proxy, or a Vercel rewrite in production.
# Set it to call a backend on another domain directly, e.g. https://api.example.com/api
# (then add the domain of this web app to CORS_ALLOWED_ORIGIN on the backend).
# The value is baked in when the app is built: change it, then build or deploy again.
VITE_API_BASE_URL=

# Dev server only: where "npm run dev" forwards /api (default http://localhost:8080).
VITE_API_PROXY=http://localhost:8080
